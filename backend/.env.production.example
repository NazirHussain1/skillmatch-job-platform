# SkillMatch Backend - Production Environment Configuration
# Copy this file to .env.local and fill in your production values

# Environment
NODE_ENV=production
PORT=5000

# Database Configuration
# REQUIRED: MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com/
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# JWT Configuration
# REQUIRED: Generate a secure random string
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=7d

# CORS and Frontend Configuration
# REQUIRED: Set to your deployed frontend domain
# Single domain: https://skillmatch.com
# Multiple domains: https://skillmatch.com,https://www.skillmatch.com
CORS_ORIGIN=https://your-frontend-domain.com
FRONTEND_URL=https://your-frontend-domain.com

# Email Configuration (Optional but recommended)
# For password reset and notification emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM=noreply@skillmatch.com
EMAIL_FROM_NAME=SkillMatch

# Cloudinary Configuration
# REQUIRED: For file uploads (profile pictures, resumes)
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin Bootstrap Configuration
# Initial admin account credentials
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@skillmatch.com
ADMIN_PASSWORD=change_this_secure_password

# Rate Limiting
# Automatically enabled in production
# Set to 'false' to disable (not recommended)
ENABLE_RATE_LIMIT=true

# Deployment Notes:
# 1. Never commit .env.local to version control
# 2. Use strong, unique passwords for production
# 3. Enable 2FA on all third-party services
# 4. Regularly rotate JWT_SECRET and API keys
# 5. Monitor rate limit logs for suspicious activity
# 6. Use HTTPS for all production domains
# 7. Keep dependencies updated for security patches
