# SkillMatch Frontend - Production Environment Configuration
# Copy this file to .env.production and fill in your production values

# API Configuration
# REQUIRED: Set to your deployed backend URL with /api suffix
# Example: https://api.skillmatch.com/api
VITE_API_URL=https://your-backend-domain.com/api

# Socket.IO Configuration (Optional)
# If not set, will use VITE_API_URL without /api suffix
# Example: https://api.skillmatch.com
# VITE_SOCKET_URL=https://your-backend-domain.com

# Feature Flags (Optional)
# Enable analytics tracking in production
# VITE_ENABLE_ANALYTICS=true

# Disable debug mode in production
# VITE_ENABLE_DEBUG=false

# Production Deployment Notes:
# 1. Never commit .env.production to version control
# 2. Ensure VITE_API_URL matches your backend deployment
# 3. Backend must have CORS configured for your frontend domain
# 4. Use HTTPS for all production URLs
# 5. Test all API endpoints after deployment
# 6. Verify Socket.IO connections work
# 7. Check that file uploads (Cloudinary) function correctly
